{ 
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Interface schema", 
     "description": "Schema for input or output interface. Validate using python -m json.tool json_schema_new.json",  
     "type": "object",
     "required": ["dd_version", "paths"],
     "additionalProperties": false,
     "properties": {

        "dd_version": {
          "description": "Version of Data Dictionary",
          "type": "string"
        },

        "paths": {
            "description": "List of sets of IDS paths",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": false,
                "properties": {
                    "all_of": {
                        "description": "List of IDS paths that need to be present",
                        "type":  "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                        "type": "string"
                        }

                    },
                    "all_or_none": {
                        "description": "Either all listed IDS paths are present or all are absent",
                        "type": "array",
                        "uniqueItems": true,
                        "minItems": 1,
                        "items": {
                            "type": "string"
                        }
                    },

                    "any_of": {
                        "description": "The path(s) listed in at least one entry of the array need to be present",
                        "type": "array",
                        "minItems": 2,
                        "items": {
                            "type": ["string","object"],
                            "minProperties": 1,
                            "maxProperties": 1,
                            "properties": {
                                "all_of": {
                                    "description": "The above constraint is applied to all of the listed paths",
                                    "type": "array",
                                    "uniqueItems": true,
                                    "minItems": 2,
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }

                }
            },
            "not": {
                "description": "Allow at most one occurence of the 'all_of'-key under 'paths'",
                "type": "array",
                "contains": {
                    "type": "object",
                    "required": ["all_of"]
                },
                "minContains": 2
            }
                     
        },

        "constraints": {
            "description": "List of constraints. IDS paths listed here do not imply presence",
            "type": "object",
            "properties": {

                "allowed_values": {
                    "description": "Entries in data arrays may only contain any of the listed values",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": ["integer","string", "number"]
                            }
                        }
                    }
                },

                "value_range": {
                    "description": "Value of entries in data array must fall within specified interval. Null implies +/- infinity",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                                "type": "number"
                            }
                        }
                    }
                },

                "has_shape": {
                    "description": "Data arrays of listed paths must have specified shape",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "integer"
                            }
                        }
                    }
                },

                "same_shape":{
                    "description": "Per entry of array, data arrays of listed paths must have the same shape",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "minProperties": 1,
                        "maxProperties": 1,
                        "additionalProperties": false,
                        "properties": {
                            "all_of": {
                                "description": "The above constraint is applied to all of the listed paths",
                                "type": "array",
                                "uniqueItems": true,
                                "minItems": 2,
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
     }
     }

