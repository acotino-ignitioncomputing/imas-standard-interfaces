{ 
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Interface schema", 
     "description": "Schema for input or output interface. Validate using python -m json.tool json_schema_new.json",  
     "type": "object",
     "properties": {

        "dd_version": {
          "description": "Version of Data Dictionary",
          "type": "string"
        },

        "paths": {
            "description": "List of IDS paths that need to be present",
            "type":  "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
               "type": "string"
            }
        },

        "optional_paths": {
            "description": "List of sets of IDS paths whose presence is optional",
            "type": "array",
            "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "properties": {
                    "all_or_none": {
                        "description": "Either all listed IDS paths are present or all are absent",
                        "type": "array",
                        "uniqueItems": true,
                        "minItems": 1,
                        "items": {
                            "type": "string"
                        }
                    },

                    "any_subset": {
                        "description": "Only the path(s) listed in a single subarray are allowed to be present",
                        "type": "array",
                        "minItems": 2,
                        "items": {

                            "type": [ "string","array"],
                            "uniqueItems": true,
                            "minItems": 1,
                            "items": {
                                "type": "string"
                                }
                        }
                    }
                }               
            }
        },

        "constraints": {
            "description": "List of constraints. IDS paths listed here do not imply presence",
            "type": "object",
            "properties": {

                "allowed_values": {
                    "description": "Entries in data arrays may only contain any of the listed values",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "integer"
                            }
                        }
                    }
                },

                "value_range": {
                    "description": "Value of entries in data array must fall within specified interval. Null implies +/- infinity",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                                "anyOf": [
                                    {"type": "number"},
                                    {"type": "null"}
                                ]
                            }
                        }
                    }
                },

                "has_shape": {
                    "description": "Data arrays of listed paths must have specified shape",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "integer"
                            }
                        }
                    }
                },

                "same_shape":{
                    "description": "Per sublist, data arrays of listed paths must have the same shape",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "uniqueItems": true,
                        "minItems": 2,
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
     },
     "anyOf": [
        {"required": ["dd_version", "paths"]},
        { "required": ["dd_version", "optional_paths"]}
     ]
     }

